# Pixi environment
.pixi/*
!.pixi/config.toml

# ROS 2 / colcon generated directories
build/
install/
log/

# Python generated files
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# TF debugging outputs
frames_*.gv
frames_*.pdf

# Local map exports (README saves to <repo>/maps/); packaged maps live in src/*/maps/
/maps/
/evidence/
/generated_maps/

# Generated Gazebo worlds copied via map_generator.py --install-to-sim (keep canonical worlds)
/src/edgeai_robot_description/worlds/*.sdf
!/src/edgeai_robot_description/worlds/empty.sdf
!/src/edgeai_robot_description/worlds/midterm_arena.sdf

# rosbag recordings
rosbag2_*/
*.db3
*.mcap

# Secrets (e.g. LLM API keys)
.env
.env.*

# Editor / IDE
.vscode/
.idea/
*~
*.swp

# OS files
.DS_Store
Thumbs.db
