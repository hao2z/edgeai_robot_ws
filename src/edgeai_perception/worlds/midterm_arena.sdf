<?xml version="1.0" ?>
<!--
  KTH EdgeAI Robotics Challenge - Midterm Check Arena
  Based on official Midterm Check Task Description & Figure 1 schematic.
  Arena dimensions: 5.0m x 5.0m inner area.
  Origin (0, 0) at the bottom-left corner of the inner arena floor.
-->
<sdf version="1.9">

  <world name="midterm_arena">

    <!-- Physics configuration -->
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for GPU LiDAR / RGB-D camera sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- 5.0m x 5.0m Perimeter Boundary Walls (thickness 0.1m) -->
    <!-- ===================================================== -->

    <!-- South wall: along y = 0.0 -->
    <model name="south_wall">
      <static>true</static>
      <pose>2.5 -0.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5.2 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.2 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North wall: along y = 5.0 -->
    <model name="north_wall">
      <static>true</static>
      <pose>2.5 5.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5.2 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.2 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall: along x = 0.0 -->
    <model name="west_wall">
      <static>true</static>
      <pose>-0.05 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.2 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.2 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall: along x = 5.0 -->
    <model name="east_wall">
      <static>true</static>
      <pose>5.05 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.2 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.2 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- Internal Walls                                        -->
    <!-- ===================================================== -->

    <!-- W1: Horizontal wall (0, 3.1) -> (2.2, 3.1), length 2.2m -->
    <model name="wall_W1">
      <static>true</static>
      <pose>1.1 3.1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- W1b: Vertical wall (2.2, 3.1) -> (2.2, 3.6), length 0.5m -->
    <model name="wall_W1b">
      <static>true</static>
      <pose>2.2 3.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.5 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- W2: Vertical wall (3.4, 0) -> (3.4, 2.8), length 2.8m connected to South wall -->
    <model name="wall_W2">
      <static>true</static>
      <pose>3.4 1.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.8 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- Obstacles                                             -->
    <!-- ===================================================== -->

    <!-- O2: Center (2.2, 2.0), rectangular footprint 0.6m x 1.0m, height 0.5m -->
    <model name="obstacle_O2">
      <static>true</static>
      <pose>2.2 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 1.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 1.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- O3: Center (4.4, 3.6), rectangular footprint 0.8m x 0.6m, height 0.5m -->
    <model name="obstacle_O3">
      <static>true</static>
      <pose>4.4 3.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- Freestanding Target Stands (S1 & C1)                  -->
    <!-- ===================================================== -->

    <!--
      S1: Single Rescue Target
      Center: (1.0, 4.1), radius 0.5m
      Marker ID: 1 (DICT_4X4_50)
      Facing: South (-Y direction, yaw = -1.570796)
      Marker pattern: 0.16m x 0.16m, center at z = 0.35m
    -->
    <model name="target_S1">
      <static>true</static>
      <pose>1.0 4.1 0 0 0 -1.570796</pose>
      <link name="link">
        <!-- Circular base foot on floor (radius 0.12m, thickness 0.02m) -->
        <visual name="base_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Vertical stand pole (height 0.34m, center z = 0.18m) -->
        <visual name="pole_visual">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.34</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.34</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Marker backing plate at z = 0.35m (0.01m x 0.20m x 0.20m) -->
        <visual name="marker_visual">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.20 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/marker_1.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="marker_collision">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.20 0.20</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!--
      C1: Cooperative Rescue Target
      Center: (4.1, 1.0), radius 0.7m
      Marker ID: 2 (DICT_4X4_50)
      Facing: North (+Y direction, yaw = 1.570796)
      Marker pattern: 0.16m x 0.16m, center at z = 0.35m
    -->
    <model name="target_C1">
      <static>true</static>
      <pose>4.1 1.0 0 0 0 1.570796</pose>
      <link name="link">
        <!-- Circular base foot on floor (radius 0.12m, thickness 0.02m) -->
        <visual name="base_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Vertical stand pole (height 0.34m, center z = 0.18m) -->
        <visual name="pole_visual">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.34</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.34</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Marker backing plate at z = 0.35m (0.01m x 0.20m x 0.20m) -->
        <visual name="marker_visual">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.20 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/marker_2.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="marker_collision">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.20 0.20</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- Lighting & Scene                                      -->
    <!-- ===================================================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2.5 2.5 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>

  </world>

</sdf>
