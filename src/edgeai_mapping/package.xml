<?xml version="1.0"?>
<package format="3">
  <name>edgeai_mapping</name>
  <version>0.1.0</version>
  <description>Single and multi-source SLAM, initial alignment and map anchors.</description>
  <maintainer email="maintainers@example.com">EdgeAI Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>slam_toolbox</depend>
  <depend>nlohmann_json</depend>
  <depend>boost</depend>
  <depend>libtbb-dev</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
