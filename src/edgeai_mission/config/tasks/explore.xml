<root BTCPP_format="4" main_tree_to_execute="Explore">
  <BehaviorTree ID="Explore">
    <Sequence>
      <TaskUnit operation="acquire"/>
      <UntilDone>
        <Sequence>
          <TaskUnit operation="poll"/>
          <!-- The fresh shared pool can obsolete a goal. Keep its reservation
               until cancellation reaches a terminal result, then reallocate. -->
          <TaskUnit operation="refresh_frontier_goals"/>
          <TaskUnit operation="dispatch"/>
          <TaskUnit operation="check_complete"/>
        </Sequence>
      </UntilDone>
      <TaskUnit operation="cancel_all_navigation"/>
      <TaskUnit operation="record_success"/>
    </Sequence>
  </BehaviorTree>
</root>
