<root BTCPP_format="4" main_tree_to_execute="AssignedSingleRescue">
  <BehaviorTree ID="AssignedSingleRescue">
    <Sequence>
      <TaskUnit operation="acquire"/>
      <TaskUnit operation="select_target"/>
      <!-- Each robot owns one target through navigation, correction and dwell. -->
      <UntilDone><TaskUnit operation="check_rescue"/></UntilDone>
      <TaskUnit operation="record_success"/>
    </Sequence>
  </BehaviorTree>
</root>
