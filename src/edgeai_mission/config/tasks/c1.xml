<root BTCPP_format="4" main_tree_to_execute="JointRescue">
  <BehaviorTree ID="JointRescue">
    <Sequence>
      <TaskUnit operation="handover"/>
      <!-- Startup readiness/localization can be retried without replaying map handover. -->
      <RetryTask attempts="{navigation_attempts}">
        <Sequence>
          <TaskUnit operation="wait_navigation_ready"/>
          <TaskUnit operation="localize"/>
        </Sequence>
      </RetryTask>
      <TaskUnit operation="prepare_target"/>
      <RetryTask attempts="{task_attempts}">
        <Sequence>
          <RetryTask attempts="{navigation_attempts}">
            <Sequence>
              <TaskUnit operation="cancel_navigation"/>
              <Fallback>
                <TaskUnit operation="select_parking_locked"/>
                <!-- Preplanning has no Nav2 recovery tree. Recover the START,
                     then require a verified path; never approve a missing path. -->
                <Sequence>
                  <TaskErrorIs category="start_occupied"/>
                  <TaskUnit operation="recover_preplan_start"/>
                  <TaskUnit operation="select_parking_locked"/>
                </Sequence>
                <!-- Retarget both only when no viable pair preserves the healthy robot. -->
                <Sequence>
                  <Inverter><TaskErrorIs category="start_occupied"/></Inverter>
                  <TaskUnit operation="cancel_all_navigation"/><TaskUnit operation="select_parking"/>
                </Sequence>
              </Fallback>
              <TaskUnit operation="dispatch_navigation"/>
              <UntilDone><TaskUnit operation="poll_navigation"/></UntilDone>
            </Sequence>
          </RetryTask>
          <UntilDone>
            <Sequence>
              <TaskUnit operation="check_rescue"/>
              <Fallback>
                <TaskDone/>
                <Sequence><CorrectionNeeded/><TaskUnit operation="correct"/></Sequence>
                <AlwaysSuccess/>
              </Fallback>
            </Sequence>
          </UntilDone>
        </Sequence>
      </RetryTask>
      <TaskUnit operation="record_success"/>
    </Sequence>
  </BehaviorTree>
</root>
