<root BTCPP_format="4" main_tree_to_execute="IntegratedMission">
  <!-- Fixed scheduling rules; each task owns its unit-behavior tree. -->
  <BehaviorTree ID="IntegratedMission">
    <Sequence>
      <SubTree ID="MappingAndTargetSearch" mapping_attempts="{mapping_attempts}"/>
      <Fallback>
        <Inverter><RescueEnabled/></Inverter>
        <Sequence>
          <ExecuteTask task="s1"/>
          <Fallback>
            <Inverter><CooperativeEnabled/></Inverter>
            <ExecuteTask task="c1"/>
          </Fallback>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
  <!-- First task: mapping and visual localization of every required rescue target. -->
  <BehaviorTree ID="MappingAndTargetSearch">
    <Sequence>
      <Repeat num_cycles="{mapping_attempts}">
        <Fallback>
          <MappingAccepted/>
          <Sequence>
            <ReactiveSequence name="ExploreWithTargetObservationGate">
              <Fallback>
                <Sequence><AllRequiredTargetsLocated/><SuppressObservation/></Sequence>
                <AlwaysSuccess/>
              </Fallback>
              <AwaitExploration/>
            </ReactiveSequence>
            <Fallback>
              <MapAreaSufficient/>
              <Sequence>
                <BeginMappingSupplement/>
                <MissionStage step="quiesce"/>
                <Parallel success_count="1" failure_count="1">
                  <AwaitFrontier/>
                  <MissionStage step="supplement_mapping"/>
                </Parallel>
                <MissionStage step="resume_exploration"/>
              </Sequence>
            </Fallback>
          </Sequence>
        </Fallback>
      </Repeat>
      <MissionStage step="quiesce"/>
      <Fallback>
        <Inverter><RescueEnabled/></Inverter>
        <ExecuteTask task="find_targets"/>
      </Fallback>
      <MissionStage step="save_map"/>
    </Sequence>
  </BehaviorTree>
</root>
